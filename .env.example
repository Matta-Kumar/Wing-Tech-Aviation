# Resend (https://resend.com) — powers the Contact and Eligibility form emails.
RESEND_API_KEY=
# Where form submissions get sent.
CONTACT_EMAIL_TO=
# Optional: must be on a domain verified in Resend. Defaults to Resend's
# shared test sender if unset (which only delivers to your own Resend
# account email).
RESEND_FROM_EMAIL=

# Optional: the site's real production URL, used for canonical links,
# Open Graph tags, and the sitemap. Defaults to the current Vercel URL.
NEXT_PUBLIC_SITE_URL=

# reCAPTCHA v2 checkbox (https://www.google.com/recaptcha/admin) — register
# the site for the domains it's served from (wingtechaviation.com,
# *.vercel.app previews, and localhost for local dev). Forms work without
# these set — the checkbox just won't appear and no verification happens.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
